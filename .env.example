# Optional: KI-Fotoerkennung mit Claude (sonst läuft Tesseract.js im Browser)
ANTHROPIC_API_KEY=
# Optional: anderes Modell für die Fotoerkennung (Standard: claude-opus-5-5)
# ANTHROPIC_OCR_MODEL=

# Optional: Teilen und Sync-Codes (Upstash Redis, z. B. über den Vercel Marketplace)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: eigene Quelle für Tesseract-Sprachdaten (Standard: jsDelivr-CDN)
# NEXT_PUBLIC_TESSDATA_URL=
